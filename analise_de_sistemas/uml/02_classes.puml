@startuml
skinparam backgroundColor #FDF6E3
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam shadowing false
skinparam ArrowColor #333333
skinparam ActorBorderColor #333333
skinparam ActorBackgroundColor #F2F2F2
skinparam UsecaseBorderColor #555555
skinparam UsecaseBackgroundColor #F2F2F2
skinparam ClassBorderColor #555555
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassHeaderBackgroundColor #D9EAF7
skinparam ParticipantBorderColor #555555
skinparam ParticipantBackgroundColor #D9EAF7
skinparam SequenceLifeLineBorderColor #888888
skinparam ActivityBorderColor #555555
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityDiamondBackgroundColor #FFF0D9
skinparam ActivityDiamondBorderColor #555555
skinparam SwimlaneBorderColor #888888
skinparam NoteBackgroundColor #FFFBEA
skinparam NoteBorderColor #AAAAAA
skinparam PackageBorderColor #555555
hide empty members
left to right direction
skinparam nodesep 25
skinparam ranksep 40
enum Classe <<enumeration>> {
  OK
  RISCO
  FALHA
}
enum TipoFluxo <<enumeration>> {
  RIPE
  LOCAL
}
enum Origem <<enumeration>> {
  REAL
  SIMULADA
}
class Sonda {
  - id : int
  - pais : str
  - asn : int
}
class Ancora {
  - id : int
  - hostname : str
  - ip_v4 : str
  - pais : str
  - asn : int
}
class Fluxo {
  - id_fluxo : str
  - tipo : TipoFluxo
  - msm_id : int
  - faixa_distancia : str
  + id() : str
}
class Medicao {
  - timestamp : int
  - rtt_min : float
  - rtt_avg : float
  - rtt_max : float
  - perda_pct : float
  - jitter_ms : float
  - ttl : int
  - origem : Origem
  + rtt_ausente() : bool
}
class Baseline {
  - n_rtt_validos : int
  - mediana_rtt : float
  - p95_rtt : float
  - p99_rtt : float
  - p95_jitter : float
  - ttl_baseline : float
  - status : str
  + calcular(medicoes_A) : Baseline
  + valido() : bool
}
class HistoricoFluxo {
  - janela : deque<Medicao> [máx. 12]
  + adicionar(m : Medicao)
  + ultimas(n : int) : list
}
class Rotulador {
  + rotular(m : Medicao, b : Baseline) : Classe
}
class ExtratorFeatures {
  + calcular(m, b, h) : VetorFeatures
}
class VetorFeatures {
  - valores : float[21]
}
class Preditor {
  - versao : str
  - familia : str
  + prever(v : VetorFeatures) : Classe
}
class Previsao {
  - timestamp : int
  - classe_atual : Classe
  - classe_prevista : Classe
  - origem : Origem
}
class Alerta {
  - nivel : Classe
  - mensagem : str
}
class HostLocal {
  - ip : str
  - nome : str
}
class ColetorICMPLocal {
  - intervalo_s : int
  - pacotes : int
  - timeout_s : float
  + pingar(h : HostLocal) : Medicao
}
class ColetorRIPE {
  - base_url : str
  + buscar(msm_id, probe_id, inicio, fim) : list<Medicao>
}
class SimuladorEventos {
  + injetar(tipo : str, intensidade : float) : Medicao
}
class Dashboard {
  + iniciar(f : Fluxo)
  + exibir(p : Previsao)
  + simular(tipo : str)
}

Sonda "0..1" -- "0..*" Fluxo : origem >
Ancora "0..1" -- "0..*" Fluxo : destino >
HostLocal "0..1" -- "0..*" Fluxo : destino >
Fluxo "1" *-- "0..*" Medicao
Fluxo "1" *-- "1" Baseline
Fluxo "1" *-- "1" HistoricoFluxo
HistoricoFluxo o-- "0..12" Medicao
Previsao "1" -- "0..1" Alerta : gera >
Dashboard --> Preditor
Dashboard --> ColetorRIPE
Dashboard --> ColetorICMPLocal
Dashboard --> SimuladorEventos
Dashboard --> Rotulador
Dashboard --> ExtratorFeatures
Dashboard ..> Previsao : exibe
ColetorRIPE ..> Medicao : cria
ColetorICMPLocal ..> Medicao : cria
SimuladorEventos ..> Medicao : cria
Rotulador ..> Baseline : usa
ExtratorFeatures ..> HistoricoFluxo : usa
ExtratorFeatures ..> VetorFeatures : cria
Preditor ..> Previsao : cria
@enduml
