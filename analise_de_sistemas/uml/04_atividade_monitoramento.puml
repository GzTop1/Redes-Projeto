@startuml
skinparam backgroundColor #FDF6E3
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam shadowing false
skinparam ArrowColor #333333
skinparam ActorBorderColor #333333
skinparam ActorBackgroundColor #F2F2F2
skinparam UsecaseBorderColor #555555
skinparam UsecaseBackgroundColor #F2F2F2
skinparam ClassBorderColor #555555
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassHeaderBackgroundColor #D9EAF7
skinparam ParticipantBorderColor #555555
skinparam ParticipantBackgroundColor #D9EAF7
skinparam SequenceLifeLineBorderColor #888888
skinparam ActivityBorderColor #555555
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityDiamondBackgroundColor #FFF0D9
skinparam ActivityDiamondBorderColor #555555
skinparam SwimlaneBorderColor #888888
skinparam NoteBackgroundColor #FFFBEA
skinparam NoteBorderColor #AAAAAA
skinparam PackageBorderColor #555555
|Analista de TI|
start
:Selecionar fluxo no painel;
|Sistema|
:Carregar baseline do fluxo;
if (Baseline válido?\n(≥ 30 RTT no Período A)) then (não)
  :Informar "fluxo sem baseline";
  stop
else (sim)
endif
repeat
  :Aguardar próxima medição (240 s);
  |API RIPE Atlas|
  :Publicar resultado do ping\n(3 pacotes);
  |Sistema|
  if (Houve resposta?) then (não)
    :Registrar RTT ausente\n(perda = 100%, RTT vazio);
  else (sim)
    :Calcular RTT, perda e jitter;
  endif
  :Aplicar regra de rotulagem\n(classe atual);
  :Atualizar fila das últimas 12 medições;
  :Calcular as 21 variáveis;
  :Prever a classe da próxima medição;
  :Gravar no histórico;
  if (Classe prevista?) then (FALHA)
    :Emitir alerta vermelho;
  elseif () then (RISCO)
    :Destacar em amarelo;
  else (OK)
    :Manter status verde;
  endif
  :Atualizar gráfico e status no painel;
  |Analista de TI|
  if (Simular evento?) then (sim)
    :Escolher tipo de falha\n(perda ou latência);
    |Sistema|
    :Injetar medição marcada\ncomo SIMULADA;
    :Classificar e exibir com\nmarcação "SIMULADO";
  else (não)
  endif
  |Analista de TI|
repeat while (Continuar monitorando?) is (sim) not (não)
:Encerrar monitoramento;
stop
@enduml
