@startuml
skinparam backgroundColor #FDF6E3
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam shadowing false
skinparam ArrowColor #333333
skinparam ActorBorderColor #333333
skinparam ActorBackgroundColor #F2F2F2
skinparam UsecaseBorderColor #555555
skinparam UsecaseBackgroundColor #F2F2F2
skinparam ClassBorderColor #555555
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassHeaderBackgroundColor #D9EAF7
skinparam ParticipantBorderColor #555555
skinparam ParticipantBackgroundColor #D9EAF7
skinparam SequenceLifeLineBorderColor #888888
skinparam ActivityBorderColor #555555
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityDiamondBackgroundColor #FFF0D9
skinparam ActivityDiamondBorderColor #555555
skinparam SwimlaneBorderColor #888888
skinparam NoteBackgroundColor #FFFBEA
skinparam NoteBorderColor #AAAAAA
skinparam PackageBorderColor #555555
autonumber
actor "Analista de TI" as ANA
participant "Dashboard" as DB
participant "ColetorRIPE" as COL
participant "API RIPE Atlas" as API
participant "Rotulador" as ROT
participant "HistoricoFluxo" as HIS
participant "ExtratorFeatures" as EXT
participant "Preditor" as PRE

ANA -> DB : iniciar(fluxo)
DB -> DB : carregar baseline do fluxo
loop a cada 240 s
  DB -> COL : buscar(msm_id, probe_id, inicio, fim)
  COL -> API : GET /measurements/{msm_id}/results/
  API --> COL : JSON (rtt, sent, rcvd, ttl)
  COL --> DB : Medicao (origem = REAL)
  DB -> ROT : rotular(medicao, baseline)
  ROT --> DB : classe_atual
  DB -> HIS : adicionar(medicao)
  DB -> EXT : calcular(medicao, baseline, historico)
  EXT -> HIS : ultimas(12)
  HIS --> EXT : janela de medições
  EXT --> DB : VetorFeatures (21 variáveis)
  DB -> PRE : prever(vetor)
  PRE --> DB : classe_prevista
  alt classe_prevista = FALHA
    DB -> ANA : exibir alerta de FALHA
  else RISCO ou OK
    DB -> ANA : atualizar status e gráfico
  end
end

opt Analista aciona "Simular evento"
  ANA -> DB : simular("perda" ou "latência")
  DB -> DB : SimuladorEventos.injetar()
  note right of DB : medição criada com\norigem = SIMULADA
  DB -> ROT : rotular(medicao_simulada, baseline)
  ROT --> DB : classe_atual
  DB -> EXT : calcular(...)
  EXT --> DB : VetorFeatures
  DB -> PRE : prever(vetor)
  PRE --> DB : classe_prevista
  DB -> ANA : exibir resultado marcado como SIMULADO
end
@enduml
